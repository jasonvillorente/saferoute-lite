# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTESERVICE_KEY: Optional server-side API key for OpenRouteService single-request avoid_polygons routing.
# Obtain a free key at openrouteservice.org. Kept securely on backend server.
# If not set, app falls back to OSRM waypoint routing.
OPENROUTESERVICE_KEY=""

# VITE_API_BASE_URL: Backend server base URL for packaged mobile apps (Capacitor Android/iOS).
# In a web browser, leave empty to use relative /api paths. For packaged mobile builds, set to your deployed backend URL.
VITE_API_BASE_URL=""

# VITE_ENABLE_CLIENT_ORS: Set to "true" only if you explicitly choose to bypass the server proxy and call ORS directly from client.
# (Requires domain restriction on your ORS dashboard token and setting VITE_OPENROUTESERVICE_KEY). Defaults to false.
VITE_ENABLE_CLIENT_ORS="false"
VITE_OPENROUTESERVICE_KEY=""

